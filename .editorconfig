root = true

[*]
charset = utf-8
end_of_line = lf

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,scss,sass,less,styl}]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{vue,html}]
indent_size = 2
indent_style = space
insert_final_newline = false
trim_trailing_whitespace = true
