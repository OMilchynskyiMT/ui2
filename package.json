{
  "name": "mtsDeviceUI",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mtcap3": "vite --mode mtcap3",
    "dev:mtr3": "vite --mode mtr3",

    "build:mtcap3": "run-p type-check \"build-only -- --mode mtcap3\"",
    "build:mtr3": "run-p type-check \"build-only -- --mode mtr3\"",

    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",

    "lint": "eslint . --cache",
    "lint:eslint": "eslint . --fix --cache",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.60.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.19.20",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  }
}
