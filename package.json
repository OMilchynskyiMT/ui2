{
  "name": "mtsDeviceUI",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mtcap3": "vite --mode mtcap3",
    "dev:mtr3": "vite --mode mtr3",

    "build:mtcap3": "run-p type-check \"build-only -- --mode mtcap3\"",
    "build:mtr3": "run-p type-check \"build-only -- --mode mtr3\"",

    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",

    "lint": "eslint . --cache",
    "lint:eslint": "eslint . --fix --cache",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@lucide/vue": "^1.39.0",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.19.20",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
